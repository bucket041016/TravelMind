DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_MODEL=deepseek-chat

# 本地 MCP 服务地址。默认演示使用 8098，避免和其他平台服务端口冲突。
MCP_PORT=8098
MCP_SERVER_URL=http://127.0.0.1:8098/my-custom-path

# 高德开放平台 Web服务 Key，用于 amap_geocode / amap_plan_routes。
# 也兼容 AMAP_API_KEY 或 GAODE_API_KEY。
AMAP_MAPS_API_KEY=your_amap_web_service_key

# 高德 API 稳定性保护：缓存 + 限速 + QPS 退避重试。
AMAP_CACHE_TTL_SECONDS=600
AMAP_CACHE_MAX_ITEMS=256
AMAP_MIN_REQUEST_INTERVAL_SECONDS=0.45
AMAP_MAX_RETRIES=3

# 可选：直接加载高德官方远程 MCP 工具。默认关闭，避免工具过多影响演示稳定性。
ENABLE_AMAP_REMOTE_MCP=false
# AMAP_MCP_URL=https://mcp.amap.com/mcp?key=your_amap_web_service_key

# Phase 3 预算反馈循环与全局质量门。默认开启；设为 off 可回滚到一次性规划路径。
TRAVELMIND_BUDGET_LOOP=on
