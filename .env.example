DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_MODEL=deepseek-chat

# 本地 MCP 服务地址。默认演示使用 8098，避免和其他平台服务端口冲突。
MCP_HOST=127.0.0.1
MCP_PORT=8098
MCP_LOG_LEVEL=info
MCP_SERVER_URL=http://127.0.0.1:8098/my-custom-path

# 高德开放平台 Web服务 Key，用于 amap_geocode / amap_plan_routes。
# 也兼容 AMAP_API_KEY 或 GAODE_API_KEY。
AMAP_MAPS_API_KEY=your_amap_web_service_key

# 高德 API 稳定性保护：缓存 + 限速 + QPS 退避重试。
AMAP_CACHE_TTL_SECONDS=600
AMAP_CACHE_MAX_ITEMS=256
AMAP_MIN_REQUEST_INTERVAL_SECONDS=0.45
AMAP_MAX_RETRIES=3

# 可选：直接加载高德官方远程 MCP 工具。默认关闭，避免工具过多影响演示稳定性。
ENABLE_AMAP_REMOTE_MCP=false
# AMAP_MCP_URL=https://mcp.amap.com/mcp?key=your_amap_web_service_key

# 可选：启用 RAG 语义向量混合检索（BM25 + 向量 RRF 重排）。
# 不配置时默认使用内置 BM25 + 中文分词 + 元数据过滤，开箱即用。
# 支持任何 OpenAI 兼容的 /embeddings 接口（如硅基流动、通义、智谱、OpenAI）。
# RAG_EMBEDDING_API_KEY=your_embedding_api_key
# RAG_EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
# RAG_EMBEDDING_MODEL=BAAI/bge-m3

# Phase 3 预算反馈循环与全局质量门。默认开启；设为 off 可回滚到一次性规划路径。
TRAVELMIND_BUDGET_LOOP=on

# 目的地知识库检索（kb_retrieve）：给高德候选补充景点详情、预约规则与雨天替代建议。
# 默认 off（灰度）；设为 on 后每次规划多发一次检索调用，并在行程项上附带 knowledge_detail。
TRAVELMIND_KNOWLEDGE=off

# ======================== 公开演示站安全与限流防刷 ========================
# 公开模式总开关：开启后禁用共享 /api/chat、保护 /api/rag/docs 写操作、关闭 Swagger 文档与服务端写盘。
TRAVELMIND_PUBLIC_MODE=off
# 限流开关：公开模式开启时默认自动启用；本地开发默认 off。
# TRAVELMIND_RATE_LIMIT=on
# 管理员口令：公开模式下修改/删除自定义 RAG 攻略时需在请求头携带 X-Admin-Token。
# TRAVELMIND_ADMIN_TOKEN=change_me_to_strong_token
# 每 IP 每日免费规划次数 / 追问次数 / 全站每日总规划上限（成本熔断） / 最大并发规划数
TRAVELMIND_DAILY_PLAN_LIMIT=3
TRAVELMIND_DAILY_REFINE_LIMIT=10
TRAVELMIND_DAILY_GLOBAL_LIMIT=100
TRAVELMIND_MAX_CONCURRENT_PLANS=3
# 可信反代网段（仅当直连来源在此范围内时才解析 X-Real-IP / X-Forwarded-For，防伪造 IP 绕过）
TRAVELMIND_TRUSTED_PROXIES=127.0.0.1/32,::1/128
# 公开模式下允许跨域的域名列表（逗号分隔；同源部署可留空）
# TRAVELMIND_CORS_ORIGINS=https://your-domain.example.com
